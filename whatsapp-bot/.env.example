# Copy to .env and fill in. Never commit .env.

# --- WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App → Settings → Basic → App secret. Used to check webhook signatures.
WHATSAPP_APP_SECRET=

PORT=3000

# retail (default) or wholesale
PRICE_LIST=retail

# The ONE published roof price, Pula per m² of house-plan area incl. VAT, for Double Roman
# (tiles + ridge caps + oxide). Leave empty to work it out from the per-tile rates
# (retail = P140). If you change it, also change PRICE_PER_M2 in ../roof-calculator.html.
PUBLISHED_PRICE_PER_M2=

# --- IBR comparison (Apache does not sell IBR – use a current local supplier price) ---
# Price in Pula per linear metre of IBR sheet. Leave empty to show sheet metres only.
IBR_PRICE_PER_LM=
# Optional allowance for screws, flashing and ridge, Pula per m² of roof.
IBR_EXTRAS_PER_M2=0
# true if the prices above already include VAT
IBR_PRICES_INCL_VAT=false
IBR_LABEL=IBR 0.47 mm

# Optional: WhatsApp number (digits only, e.g. 2677xxxxxxx) to notify about quote requests.
SALES_NOTIFY_NUMBER=
